{
  "identifier": "default",
  "description": "Default capabilities for redrafter's main window: the core defaults, the plugins A14/B23 wire up (global-shortcut, autostart, updater), and every app command (autogenerated by build.rs's AppManifest::commands list — see COMMANDS there for the source of truth). Every registered command in lib.rs's invoke_handler must have its allow-<command> grant here, or it is silently denied at runtime.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "autostart:default",
    "updater:default",
    "allow-settings-get",
    "allow-settings-set",
    "allow-permission-status",
    "allow-permission-open-settings",
    "allow-hotkey-set",
    "allow-connection-add",
    "allow-connection-list",
    "allow-refine",
    "allow-restore-original",
    "allow-inject-text",
    "allow-cancel-refine",
    "allow-tray-refine",
    "allow-tray-quit",
    "allow-connection-edit",
    "allow-connection-remove",
    "allow-connection-test",
    "allow-connection-refresh-models",
    "allow-model-add-manual",
    "allow-models-list",
    "allow-model-set-active",
    "allow-model-disable",
    "allow-model-toggle-favorite",
    "allow-ollama-pull",
    "allow-secrets-set",
    "allow-secrets-set-key",
    "allow-secrets-delete",
    "allow-tray-set-active-model",
    "allow-tray-pause",
    "allow-tray-resume",
    "allow-tray-check-updates",
    "allow-tray-set-launch-login",
    "allow-preset-list",
    "allow-preset-save",
    "allow-preset-delete",
    "allow-preset-duplicate",
    "allow-preset-reset-default",
    "allow-preset-export",
    "allow-preset-import",
    "allow-preset-resolve",
    "allow-history-list",
    "allow-history-get",
    "allow-history-restore",
    "allow-history-rerefine",
    "allow-history-copy",
    "allow-history-clear",
    "allow-feedback-config-get",
    "allow-feedback-config-set",
    "allow-open-external",
    "allow-claude-code-status",
    "allow-claude-code-connect"
  ]
}
